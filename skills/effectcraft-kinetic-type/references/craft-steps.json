{
  "schema": "craft-scenario-playbooks/v1",
  "application": "effectcraft",
  "id": "kinetic-type",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立文字动画合成",
      "command": "comp.new",
      "params": {
        "name": "Type",
        "width": 1080,
        "height": 1920,
        "duration": 5,
        "frameRate": 30
      }
    },
    {
      "purpose": "按语义建立一组可读文案",
      "command": "layer.newText",
      "params": {
        "text": "准确的短文案",
        "name": "Phrase",
        "size": 64
      }
    },
    {
      "purpose": "为当前文本创建首末透明度",
      "command": "prop.addKey",
      "params": {
        "path": "transform/opacity",
        "time": 0,
        "value": 0
      }
    },
    {
      "purpose": "留足可读停留时长",
      "command": "prop.addKey",
      "params": {
        "path": "transform/opacity",
        "time": 0.5,
        "value": 100
      }
    }
  ],
  "check": "按真实播放速度检查字词顺序、标点与停留，不只看静止帧。",
  "boundary": "多个词组分别建层和错开时间，不能同时闪入再称为节奏排版。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
