{
  "schema": "craft-scenario-playbooks/v1",
  "application": "effectcraft",
  "id": "logo-reveal",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立与目标规格一致的合成",
      "command": "comp.new",
      "params": {
        "name": "Logo",
        "width": 1920,
        "height": 1080,
        "frameRate": 25,
        "duration": 4
      }
    },
    {
      "purpose": "示例先建标题层，真实任务替换为标志素材",
      "command": "layer.newText",
      "params": {
        "text": "品牌名称",
        "name": "LogoTitle"
      }
    },
    {
      "purpose": "设置首帧透明度关键帧",
      "command": "prop.addKey",
      "params": {
        "path": "transform/opacity",
        "time": 0,
        "value": 0
      }
    },
    {
      "purpose": "在1秒达到完全显示",
      "command": "prop.addKey",
      "params": {
        "path": "transform/opacity",
        "time": 1,
        "value": 100
      }
    }
  ],
  "check": "预览0、0.5、1与末帧，标志比例不变且停留足够。",
  "boundary": "真实标志应由layer.addItem引用已导入素材ID；文字示例不替代品牌标志。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
