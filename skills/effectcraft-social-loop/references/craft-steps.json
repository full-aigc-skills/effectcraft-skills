{
  "schema": "craft-scenario-playbooks/v1",
  "application": "effectcraft",
  "id": "social-loop",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立短循环合成",
      "command": "comp.new",
      "params": {
        "name": "Loop",
        "width": 1080,
        "height": 1080,
        "duration": 3,
        "frameRate": 30
      }
    },
    {
      "purpose": "建立可循环运动的图形",
      "command": "layer.newShape",
      "params": {
        "kind": "ellipse",
        "name": "Dot",
        "size": [
          80,
          80
        ],
        "fill": "#2457cc"
      }
    },
    {
      "purpose": "起点关键帧",
      "command": "prop.addKey",
      "params": {
        "path": "transform/position",
        "time": 0,
        "value": [
          200,
          540
        ]
      }
    },
    {
      "purpose": "中点关键帧",
      "command": "prop.addKey",
      "params": {
        "path": "transform/position",
        "time": 1.5,
        "value": [
          880,
          540
        ]
      }
    },
    {
      "purpose": "终点恢复起点",
      "command": "prop.addKey",
      "params": {
        "path": "transform/position",
        "time": 3,
        "value": [
          200,
          540
        ]
      }
    }
  ],
  "check": "连续循环看接缝，检查首尾位置和速度，必要时调缓动。",
  "boundary": "首尾位置一致不证明速度连续；导出应避免重复计入终点帧。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
