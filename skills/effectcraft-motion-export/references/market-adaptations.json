    {
      "id": "motion-export",
      "title": "可编辑工程与渲染分别验收",
      "sourceIds": [
        "iart-ai/motion-design-skills/after-effects"
      ],
      "adaptation": "先检查工作区间、尺寸、帧率、媒体链接和透明背景需求，保存可编辑副本；只使用实际可用的渲染接口。渲染后检查持续时间、首尾帧和透明通道。",
      "taskCheck": "工程可重开；若已渲染，独立解码检查真实输出。",
      "capabilityBoundary": "本映射仅保存工程和检查区间，没有把file.saveCopy当成视频渲染；编码能力缺失时交接工程。",
      "existingRecipe": "skills/effectcraft-motion-export/references/craft-steps.json",
      "recipe": {
        "schema": "craft-scenario-playbooks/v1",
        "application": "effectcraft",
        "id": "motion-export",
        "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
        "steps": [
          {
            "purpose": "明确工作范围",
            "command": "comp.workArea",
            "params": {
              "start": 0,
              "end": 3
            }
          },
          {
            "purpose": "读取工程合成与图层结构",
            "command": "project.summary",
            "params": {}
          },
          {
            "purpose": "另存可编辑工程副本",
            "command": "file.saveCopy",
            "params": {
              "path": "output/motion.ecproj"
            }
          }
        ],
        "check": "先渲染短片段，完整输出后独立检查时长、帧率、音频与alpha。",
        "boundary": "真正视频输出用CLI render --out ... --start ... --end ...；保存工程成功不等于渲染完成。",
        "templateOnly": true,
        "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
      },
      "execution": "REFERENCE_ADAPTATION_NOT_NEW_RUNTIME_ACCEPTANCE"
    }
  ],
